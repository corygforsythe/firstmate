+  BRIDGE_PID=""
+  stop_drain
+  exec 3>&- 4>&-
+  stop_stub
+  pass "status protocol: a valid FIRSTMATE-STATUS line in a completed turn's real text lands in the real local status file, sentinel stripped"
+}
