+    os._exit(127)
+
+transcript = open(transcript_path, "wb")
+
+def pump(timeout, want=None):
+    deadline = time.time() + timeout
+    buf = b""
+    while time.time() < deadline:
+        r, _, _ = select.select([fd], [], [], 0.5)
+        if fd in r:
+            try:
+                chunk = os.read(fd, 65536)
+            except OSError:
+                break
+            if not chunk:
+                break
+            transcript.write(chunk)
+            transcript.flush()
