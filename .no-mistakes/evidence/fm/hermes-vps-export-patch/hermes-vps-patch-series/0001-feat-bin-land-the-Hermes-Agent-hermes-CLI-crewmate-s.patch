+import os
+import pty
+import select
+import subprocess
+import sys
+import time
+
+hermes_bin, workspace, transcript_path, brief_real = sys.argv[1:5]
+
+pointer = "Read the brief at %s and follow it exactly." % brief_real
+
+pid, fd = pty.fork()
